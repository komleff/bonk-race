{
  "name": "bonk-race",
  "version": "0.6.3",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared",
    "admin-dashboard"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"meta,match,client\" \"npm run dev:meta --workspace=server\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "start:servers": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"server,client\" \"npm run dev:server\" \"npm run dev:client\"",
    "stop:servers": "node -e \"const { exec } = require('child_process'); exec(process.platform === 'win32' ? 'scripts\\\\stop-servers.bat' : 'scripts/stop-servers.sh')\"",
    "prebuild": "node scripts/sync-version.js",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client && npm run build --workspace=admin-dashboard",
    "test": "npm --workspaces --if-present test",
    "sync-version": "node scripts/sync-version.js",
    "check-version": "node scripts/check-version.js",
    "postinstall": "node scripts/install-hooks.js",
    "test:tuglab": "tsc -p client/tsconfig.tuglab-test.json && node --test tests/tuglab/*.test.cjs",
    "typecheck:tuglab": "tsc -p client/tsconfig.tuglab-test.json --noEmit",
    "dev:tuglab": "npm run dev:tuglab --workspace=client",
    "build:tuglab": "npm run build:tuglab --workspace=client",
    "test:tuglab:ui": "node tests/tuglab/ui-smoke.cjs",
    "qa:tuglab:matrix": "tsc -p client/tsconfig.tuglab-test.json && node tests/tuglab/qa-matrix.cjs",
    "qa:tuglab:browser": "node tests/tuglab/qa-browser.cjs",
    "dev:u2taglab": "npm run dev:u2taglab --workspace=client",
    "build:u2taglab": "npm run build:u2taglab --workspace=client",
    "test:u2taglab:ui": "node tests/tuglab/u2taglab-ui.cjs",
    "qa:u2taglab:browser": "node tests/tuglab/u2taglab-built-browser.cjs",
    "qa:u2taglab:matrix": "tsc -p client/tsconfig.tuglab-test.json && node tests/tuglab/u2taglab-qa-matrix.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "tsconfig-paths": "^4.2.0"
  }
}
