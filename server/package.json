{
  "name": "@bonk-race/server",
  "version": "0.2.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/index.ts",
    "dev:meta": "ts-node-dev -r tsconfig-paths/register src/meta/server.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "start:meta": "node dist/server/src/meta/server.js",
    "db:migrate": "node dist/server/src/db/migrate.js",
    "test": "npm run build && node tests/determinism.test.js && node tests/orb-bite.test.js && node tests/arena-generation.test.js && node tests/anisotropic-friction.test.js",
    "test:admin": "ts-node tests/admin-auth.test.ts"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.15.0",
    "@bonk-race/shared": "*",
    "bcrypt": "^5.1.1",
    "colyseus": "^0.15.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.2.2",
    "pg": "^8.11.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
