{
  "[beads]": {
    "editor.defaultFormatter": "planet57.vscode-beads"
  },
  "beads.showStatusBar": true,
  "beads.groupBy": "priority",
  "beads.autoRefresh": true,
  "beads.refreshInterval": 5000,
  "chat.tools.terminal.autoApprove": {
    "/^git (status|log|diff|show|fetch|branch|stash|tag|add|commit|pull)( |$)/": true,
    "/^git push(?!.*(-f |--force|origin main))/": true,
    "/^gh (pr|issue) (view|list|comment|review --comment)/": true,
    "/^(ls|cat|find|grep|rg|head|tail|wc|echo|pwd|which|env)/": true,
    "/^(npm run|npx|node( |$))/": true,
    "/^bd /": true
  }
}

